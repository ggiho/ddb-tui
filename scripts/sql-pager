#!/usr/bin/env python3
"""Use sql-viewer for supported large tables, preserving the text pager fallback."""
import os
import re
import signal
import stat
import tempfile
import subprocess
import sys
import unicodedata
from pathlib import Path

SGR = re.compile(r"\x1b\[[0-9;:]*m")


def width(text, limit=None):
    column = 0
    for char in SGR.sub("", text):
        if char == "\t":
            column += 8 - column % 8
        elif not unicodedata.combining(char) and not unicodedata.category(char).startswith("C"):
            column += 2 if unicodedata.east_asian_width(char) in "WF" else 1
        if limit is not None and column > limit:
            return column
    return column


def fits(data, columns, rows):
    lines = data.decode("utf-8", "replace").splitlines()
    return len(lines) < rows and all(width(line, limit=columns) <= columns for line in lines)


def run(command, data):
    previous = signal.signal(signal.SIGINT, signal.SIG_IGN)
    try:
        child = subprocess.Popen(command, stdin=subprocess.PIPE)
        child.communicate(data)
        return child.returncode
    finally:
        signal.signal(signal.SIGINT, previous)


# A private, per-CLI directory is created and removed by the client process.
MAX_CACHE_BYTES = 64 * 1024 * 1024


def session_directory():
    value = os.environ.get("SQL_VIEWER_SESSION")
    if not value:
        return None
    directory = Path(value)
    try:
        info = directory.lstat()
        if stat.S_ISDIR(info.st_mode) and info.st_uid == os.getuid() and not info.st_mode & 0o077:
            return directory
    except OSError:
        pass
    return None


def remember(directory, data):
    if directory is None:
        return
    # A new result invalidates the previous viewport, even for identical rows.
    for name in ["view.json", "result", "query.json"]:
        (directory / name).unlink(missing_ok=True)
    if len(data) > MAX_CACHE_BYTES:
        return
    with tempfile.NamedTemporaryFile(dir=directory, delete=False) as target:
        temporary = Path(target.name)
        try:
            target.write(data)
            target.close()
            temporary.replace(directory / "result")
        finally:
            temporary.unlink(missing_ok=True)


def main():
    directory = session_directory()
    resume = "--resume" in sys.argv[1:]
    if resume:
        try:
            if directory is None:
                raise FileNotFoundError
            data = (directory / "result").read_bytes()
        except OSError:
            print("No saved result in this session. Run a query first.", file=sys.stderr)
            return 0
    else:
        data = sys.stdin.buffer.read()
        try:
            remember(directory, data)
        except OSError as error:
            print(f"(could not remember SQL result: {error})", file=sys.stderr)
    if "--remember" in sys.argv[1:]:
        return 0
    try:
        columns, rows = os.get_terminal_size(sys.stdout.fileno())
    except OSError:
        sys.stdout.buffer.write(data)
        return 0
    if not resume and os.environ.get("SQL_VIEWER_ALWAYS") != "1" and fits(data, columns, rows):
        sys.stdout.buffer.write(data)
        return 0
    binary = Path.home() / ".local/bin/sql-viewer"
    try:
        args = [str(binary), "--escaped"]
        if directory is not None:
            args.extend(["--view-state", str(directory / "view.json")])
        status = run(args, data)
    except OSError:
        status = 127
    if status == 0:
        return 0
    # The original bytes reach less even if parsing, initialization or rendering fails.
    if status != 2:
        print(f"(sql-viewer exited {status}; using text pager)", file=sys.stderr)
    fallback = Path(__file__).resolve().with_name("less")
    if fallback.is_file():
        return run([str(fallback)], data)
    return run(["/usr/bin/less", "-R", "-S"], data)


if __name__ == "__main__":
    sys.exit(main())
